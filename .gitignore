# Build output
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
*.o
*.obj
*.exe
*.a
*.lib

# Data is regenerated, never committed.
data/*.csv

# Results are regenerated too, except the plots the README links to -- a
# README whose figures only exist on the machine that ran it is not a README.
# Excluding the directory itself would stop git descending into it, so the
# contents are excluded instead and the plots negated back in.
results/*
!results/*.png

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/
